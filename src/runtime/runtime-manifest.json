{
  "name": "catpaw-runtime",
  "version": "3.4.0",
  "runtimePath": "~/.catpaw",
  "boardSchemaVersion": 2,
  "released": "2026-08-14",
  "canonicalFiles": [
    "VERSION",
    "runtime-manifest.json",
    "README.md",
    "AI-INSTALL.md",
    "CHANGELOG.md",
    "runtime-policy.md",
    "bin/",
    "catalog/",
    "guidance/",
    "lenses/",
    "lib/",
    "migrations/",
    "providers/",
    "schemas/",
    "snippets/",
    "templates/"
  ],
  "cli": {
    "entrypoint": "bin/catpaw.mjs",
    "commands": [
      "status",
      "board init|status|doctor|migrate",
      "work start|show|update|finish|cancel",
      "milestone start|show|add|finish|cancel",
      "proof add|list|show",
      "intent list|show",
      "transport check|open|send|status|read|close"
    ]
  },
  "projectArtifactPath": ".catpaw",
  "legacyRuntimePaths": [
    "commands/",
    "guides/",
    "roles/",
    "source-evidence/",
    "specs/",
    "tools/"
  ]
}
